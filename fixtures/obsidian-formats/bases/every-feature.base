filters:
  and:
    - 'file.ext == "md"'
    - or:
        - 'status == "active"'
        - not:
            - 'file.hasTag("archived")'
formulas:
  display_status: 'if(status == "active", "Status: active", "Status # other")'
  quoted_cost: 'if(price, price.toFixed(2) + " AUD", "n/a")'
properties:
  status:
    displayName: "Status: current"
  formula.display_status:
    displayName: Display status
  file.ext:
    displayName: Extension
summaries:
  precise_average: 'values.mean().round(3)'
views:
  - type: table
    name: Active table
    limit: 25
    groupBy:
      property: status
      direction: ASC
    filters:
      and:
        - 'formula.display_status != ""'
    order:
      - file.name
      - status
      - formula.display_status
      - formula.quoted_cost
    sort:
      - property: file.mtime
        direction: DESC
    summaries:
      price: precise_average
  - type: cards
    name: Gallery
    order:
      - file.name
      - cover
  - type: list
    name: Compact
    order:
      - file.name
  - type: map
    name: Locations
    latitudeProperty: latitude
    longitudeProperty: longitude
